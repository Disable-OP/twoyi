<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.twoyi">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:name=".TwoyiApplication"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twoyi" >

        <activity android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Allow a file manager (or `adb shell am start`) to open a ROM
              file directly with twoyi. This is equivalent to what the SAF
              picker does internally (return a content/file URI to the
              caller), but skips the unreliable picker UI entirely — useful
              for E2E UI tests and a nicer UX for users who tap a .img file
              in their file manager.

              SettingsActivity.onCreate / onNewIntent inspects the intent;
              if action == ACTION_VIEW and data is a file/content URI, it
              calls importRomForActiveProfile(uri) directly (the same path
              the picker's onActivityResult takes).

              pathPattern restricts to the ROM formats RamdiskImporter
              understands (.img / .tar / .cpio / .zip), so twoyi is NOT
              offered for unrelated files. MIME is */* because the SAF
              picker uses */* and Android sometimes infers a wrong MIME
              type for .img files (e.g. image/*).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.img" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.cpio" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
        </activity>

        <activity android:name=".Render2Activity"
            android:theme="@style/Theme.Twoyi.FullScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>


        <activity
            android:name=".ui.AboutActivity"
            android:label="@string/about_btn"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SelectAppActivity"
            android:label="@string/create_app_activity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ProfileManagerActivity"
            android:label="@string/profile_manager_title"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 6-Z264: rootfs file manager (browse/edit/chmod the active
             profile's backing rootfs from the host side). -->
        <activity
            android:name=".ui.FileManagerActivity"
            android:label="@string/settings_rootfs_fm_title"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.twoyi.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <provider
            android:name=".provider.TwoyiDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>