<!-- 6-Z264: rootfs file manager — browse/edit the active profile's
     backing rootfs directly (host-side), including permission editing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/fmWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/fm_warning_running"
        android:textColor="@android:color/holo_orange_light"
        android:textSize="12sp"
        android:visibility="gone"
        android:background="#33FF8800" />

    <TextView
        android:id="@+id/fmPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="start"
        android:textColor="?android:attr/textColorSecondary"
        android:text="/" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/fmList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?android:attr/listDivider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@android:id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/fm_empty"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>
</LinearLayout>
