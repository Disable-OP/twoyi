// For format details, see https://containers.dev/implementors/json_reference/
//
// Codespace configuration for twoyi development.
// Uses a Dockerfile (not features) to guarantee a Ubuntu/glibc base,
// which the Android emulator binary requires.
//
// Machine size: 4 cores / 16 GB RAM / 32 GB disk (standardLinux32gb).
// Select this in the GitHub UI when creating the codespace.
//
// runArgs: --privileged is included so we can mknod /dev/kvm if the
//   underlying Azure VM has nested virtualization support. The seccomp
//   profile applied by Codespaces may still block KVM_RUN ioctls on
//   some VM series; AMD EPYC VMs (Dv4/Dv5) are known to allow it.
{
  "name": "twoyi-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "runArgs": [
    "--privileged",
    "--init"
  ],

  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  "containerEnv": {
    "ANDROID_HOME": "/workspaces/twoyi/.android-sdk",
    "ANDROID_NDK_HOME": "/workspaces/twoyi/.android-ndk",
    "ANDROID_SDK_ROOT": "/workspaces/twoyi/.android-sdk",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
  },

  "postCreateCommand": "bash .devcontainer/scripts/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "swellaby.rust-pack",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.linkedProjects": [
          "app/rs/Cargo.toml",
          "app/rs/loader/Cargo.toml",
          "app/rs/kr64/Cargo.toml"
        ],
        "files.watcherExclude": {
          "**/target/**": true,
          "**/.gradle/**": true,
          "**/build/**": true
        }
      }
    }
  },

  "remoteUser": "vscode"
}
